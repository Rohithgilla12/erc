DATABASE_URL=postgres://erc:erc@localhost:54329/erc
PAYLOAD_SECRET=change-me

# Lets payload run scripts expire the running site's cache after a write. Both unset means scripts only warn.
ERC_SITE_URL=http://localhost:3000
REVALIDATE_SECRET=

# Media goes to Cloudflare R2 only when all five are set; otherwise uploads stay on local disk.
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=

# Production mounts a volume here when R2 is not configured.
MEDIA_DIR=

# Email goes out over SMTP only when all five are set; a partial set stops the server. EMAIL_FROM is an address or "Name <address>".
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Staff address told about each new enquiry. Needs email configured; otherwise enquiries are only stored.
ENQUIRY_NOTIFY_TO=

# Strava sync is off unless STRAVA_ENABLED is "true". The athlete cap defaults to 10.
STRAVA_ENABLED=
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:3000/api/v1/strava/callback
STRAVA_WEBHOOK_VERIFY_TOKEN=
STRAVA_ATHLETE_CAP=

# "Continue with Google" shows on /sign-in only when both are set. Redirect URI: <ERC_SITE_URL>/api/v1/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
