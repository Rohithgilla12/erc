DATABASE_URL=postgres://erc:erc@localhost:54329/erc
PAYLOAD_SECRET=change-me

# Lets payload run scripts expire the running site's cache after a write. Both unset means scripts only warn.
ERC_SITE_URL=http://localhost:3000
REVALIDATE_SECRET=

# Media goes to Cloudflare R2 only when all five are set; otherwise uploads stay on local disk.
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=

# Production mounts a volume here when R2 is not configured.
MEDIA_DIR=
